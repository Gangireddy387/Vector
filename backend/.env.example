# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (first one is used in email links)
CLIENT_URL=http://localhost:5173

# --- Auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Super admin -----------------------------------------------------------
# The portal owner. Signs in like anyone else and approves new organizations at /super-admin.
# The account is created on startup; changing the password here and restarting updates it.
# Leave SUPER_ADMIN_EMAIL empty to approve new organizations automatically.
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
SUPER_ADMIN_NAME=Super Admin

# --- Database Configuration (PostgreSQL) ----------------------------------
# The database is created automatically on first start if it does not exist.
DB_NAME=vector
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_LOGGING=false
# Alternatives: a single connection string (takes precedence) ...
# DATABASE_URL=postgres://user:password@localhost:5432/vector
# ... or remove DB_NAME to fall back to a local SQLite file:
# DB_STORAGE=data/vector.sqlite
# Create missing tables automatically on startup
DB_AUTO_SYNC=true

# --- Email (SendGrid) -----------------------------------------------------
# Without a key, emails are printed to the console instead of being sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=Vector

# --- AI assistant (OpenAI) -----------------------------------------------
# Without a key, the assistant uses built-in heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Files & jobs ---------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=20
JOBS_ENABLED=true
