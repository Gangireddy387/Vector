# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (first one is used in email links)
CLIENT_URL=http://localhost:5173

# --- Auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Super admin -----------------------------------------------------------
# The portal owner. Signs in like anyone else and approves new organizations at /super-admin.
# The account is created on startup; changing the password here and restarting updates it.
# Leave SUPER_ADMIN_EMAIL empty to approve new organizations automatically.
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
SUPER_ADMIN_NAME=Super Admin

# --- Database Configuration (PostgreSQL) ----------------------------------
# The database is created automatically on first start if it does not exist.
DB_NAME=vector
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_LOGGING=false
# Alternatives: a single connection string (takes precedence) ...
# DATABASE_URL=postgres://user:password@localhost:5432/vector
# ... or remove DB_NAME to fall back to a local SQLite file:
# DB_STORAGE=data/vector.sqlite
# Create missing tables automatically on startup
DB_AUTO_SYNC=true

# --- Email (SendGrid) -----------------------------------------------------
# Without a key, emails are printed to the console instead of being sent.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
SENDGRID_FROM_NAME=Vector

# --- AI assistant (OpenAI) -----------------------------------------------
# Without a key, the assistant uses built-in heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Meetings (video calls) -------------------------------------------------
# Calls go browser to browser. STUN finds the direct path; a TURN relay carries the video when a strict office
# or mobile network blocks direct connections. Without TURN, some people see black video tiles.
# Pages must be served over https:// (localhost is fine for development) or browsers block the camera.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Option A, your own coturn server (static-auth-secret in turnserver.conf): passwords expire after TURN_TTL_SECONDS.
# TURN_URLS=turn:turn.yourdomain.com:3478?transport=udp,turn:turn.yourdomain.com:3478?transport=tcp,turns:turn.yourdomain.com:5349?transport=tcp
# TURN_SECRET=the-same-long-random-secret-as-in-turnserver.conf
# Option B, Cloudflare Realtime TURN (dashboard > Realtime > TURN keys):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Option C, a provider with a fixed login: TURN_URLS plus
# TURN_USERNAME=
# TURN_PASSWORD=
TURN_TTL_SECONDS=21600

# --- Push notifications (calls ring on phones and computers) -----------------
# Generate once with `npx web-push generate-vapid-keys` and keep them: new keys silently stop every device's
# notifications. Left empty, a pair is generated on first start and saved in VAPID_KEYS_FILE.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
# VAPID_KEYS_FILE=data/vapid-keys.json

# --- Files & jobs ---------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=20
JOBS_ENABLED=true
