# Base URL of the API. Keep "/api" in development (Vite proxies it to the backend).
VITE_API_URL=/api
# Socket.IO server origin. Leave empty to use the same origin as the app (proxied in development).
VITE_SOCKET_URL=

# Legal pages (/privacy and /terms). Fill these in before deploying.
VITE_LEGAL_COMPANY_NAME=Your Company Ltd
VITE_LEGAL_CONTACT_EMAIL=privacy@yourcompany.com
VITE_LEGAL_POSTAL_ADDRESS=123 Example Street, City, Country
VITE_LEGAL_JURISDICTION=England and Wales
VITE_LEGAL_EFFECTIVE_DATE=24 October 2026
